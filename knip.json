{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "apps/api": {
      "entry": ["scripts/*.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
      "ignore": ["src/platform/db/generated.ts"],
      "ignoreDependencies": ["pino-pretty"]
    },
    "packages/contracts": {
      "project": ["src/**/*.ts"]
    },
    "packages/api-client": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
