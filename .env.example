# Copy to apps/api/.env (or export in your shell). NEVER commit real secrets.
# Every variable is validated at boot by apps/api/src/config.ts; defaults suit local dev.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Externally reachable base URL of this API (used to build signed local-storage URLs).
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info
TRUST_PROXY_HOPS=0

# --- Database (matches docker-compose.yml) -------------------------------------------------
DATABASE_URL=postgres://runningapp:runningapp@localhost:5432/runningapp
DATABASE_POOL_MAX=10
DATABASE_SSL=false
# Apply pending migrations when the API boots (dev default: true; production default: false).
AUTO_MIGRATE=true
# Optional. When set, rate limiting uses Redis so limits are shared across API replicas.
# REDIS_URL=redis://localhost:6379

# --- Auth ----------------------------------------------------------------------------------
# REQUIRED in production (>= 32 chars). Generate: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-change-me
# During rotation, keep the old secret here so existing tokens verify until they expire.
# JWT_SECRET_PREVIOUS=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_AGE_DAYS=90

# --- Dev conveniences (REFUSED when NODE_ENV=production) ----------------------------------------
DEV_AUTO_VERIFY_EMAIL=true
DEV_ENDPOINTS_ENABLED=true

# --- Email ---------------------------------------------------------------------------------
# console: writes mail to the dev outbox table (GET /v1/dev/outbox). smtp: real delivery.
MAIL_DRIVER=console
MAIL_FROM="RunningApp <no-reply@example.invalid>"
# SMTP_URL=smtp://localhost:1025
EMAIL_LINK_BASE_URL=runningapp://

# --- Media storage -------------------------------------------------------------------------
# local: files on disk under LOCAL_STORAGE_DIR, signed URLs served by this API (dev only).
# s3: any S3-compatible store (AWS S3, Cloudflare R2, MinIO, ...). Required in production.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.local-storage
# REQUIRED in production (>= 32 chars). Signs local-storage URLs.
MEDIA_SIGNING_SECRET=change-me-change-me-change-me-change-me-change-me
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=runningapp-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Workers -------------------------------------------------------------------------------
# Run the job worker inside the API process (dev default: true). In production run `pnpm start:worker`.
WORKER_INLINE=true

# --- Policy --------------------------------------------------------------------------------
MIN_SIGNUP_AGE=13
MINOR_PUBLIC_MIN_AGE=16
# Comma-separated words that make the baseline text moderator flag content for review.
# MODERATION_FLAG_TERMS=

# --- Feed & analytics ---
# Fraction (0..1) of served feed pages whose per-item ranking decisions are logged for future ML.
RANKING_LOG_SAMPLE_RATE=1
# How long a ranked Home/Explore refresh stays paginatable, and how many items it holds.
FEED_SNAPSHOT_TTL_MINUTES=30
FEED_SNAPSHOT_SIZE=100
# Raw behavioural events and the serving log are deleted after this many days.
ANALYTICS_RETENTION_DAYS=180
