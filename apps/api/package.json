{
  "name": "@runningapp/api",
  "version": "0.1.0",
  "description": "RunningApp backend: modular monolith (Fastify + PostgreSQL).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions source src/server.ts",
    "worker": "tsx --conditions source src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --conditions source scripts/migrate.ts",
    "db:seed": "tsx --conditions source scripts/seed.ts",
    "db:reset": "tsx --conditions source scripts/reset.ts",
    "db:codegen": "tsx --conditions source scripts/codegen.ts",
    "admin:grant": "tsx --conditions source scripts/grant-role.ts",
    "openapi:generate": "tsx --conditions source scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.1",
    "@node-rs/argon2": "^2.2.2",
    "@runningapp/contracts": "workspace:*",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "nodemailer": "^10.0.15",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
